# Local development environment. Copy to `.env` and fill in.
# `.env` is gitignored; `.env.example` is the documented template.
#
# Every VITE_* value is inlined into the bundle at build time and is therefore
# public in any deployed site. Never put anything here that must stay private.

# Alchemy API key used to derive RPC endpoints for all configured chains.
#
# Use YOUR OWN key for local development. The production key is restricted to
# the mazeking.io origin and will not work from localhost, so it is neither
# shared nor needed here. A free Alchemy key with no origin restriction is
# sufficient for local work.
#
# Leaving this blank is fine: the app falls back to shared public RPCs, which
# are rate-limited but functional for casual local use.
VITE_ALCHEMY_KEY=

# Optional per-chain overrides. These take precedence over the key above, for
# cases where one network should use a different provider.
# VITE_SEPOLIA_RPC_URL=
# VITE_POLYGON_ZKEVM_RPC_URL=
