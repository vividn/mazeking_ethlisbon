{
  "name": "maze-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e-full": "RUN_E2E_FULL_PROOF=1 vitest run e2eSolveProve",
    "test:e2e-mint": "RUN_E2E_MINT=1 vitest run e2eMintOnAnvil",
    "build:attestor": "vite build --config vite.attestor.config.ts",
    "test:attestation": "RUN_ATTESTATION=1 vitest run attestation"
  },
  "dependencies": {
    "@aztec/bb.js": "catalog:zktools",
    "@noir-lang/noir_js": "catalog:zktools",
    "@tanstack/react-query": "^5.90.16",
    "buffer": "^6.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.14.2",
    "viem": "^2.43.5",
    "wagmi": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vite-node": "^6.0.0",
    "vitest": "^1.0.0"
  }
}
